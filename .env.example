# このファイルをコピーして .env を作る。.env はコミットしない。
#   cp .env.example .env

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Tokyo
DJANGO_LOG_LEVEL=INFO

# --- データベース ---
# 既定は SQLite。PostgreSQL を使う場合は以下の形式で指定する。
# DATABASE_URL=postgres://verirag:verirag@localhost:5432/verirag

# --- AI プロバイダ ---
# openai | ollama | local_hash
# local_hash は API キー不要の検証用。CI とテストではこれを使う。
AI_PROVIDER=local_hash

OPENAI_API_KEY=
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

LOCAL_HASH_EMBEDDING_MODEL=local-hash-v1
LOCAL_HASH_EMBEDDING_DIM=256

# --- RAG ---
RAG_DEFAULT_TOP_K=8
RAG_USE_LLM_RERANK=False
RAG_USE_QUERY_EXPANSION=False

# --- Agentic ---
AGENT_MAX_LOOPS=3
AGENT_TIMEOUT_SECONDS=120
